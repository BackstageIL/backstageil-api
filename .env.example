# Copy to .env (git-ignored) and fill in locally. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Neon connection string for your dev branch, e.g. postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
# true only for a connection-pooler endpoint (Neon "-pooler", used on Vercel)
DB_POOLED=false
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Salted scrypt hash of the admin API key (generate with: uv run python -m scripts.new_admin_key).
# Empty = admin endpoints disabled.
ADMIN_API_KEY_HASH=
# Sentry DSN for error tracking (production only, set in Vercel). Empty = no error reports.
SENTRY_DSN=
# Vercel Blob read-write token of the DEV picture store (Vercel → Storage → the store → .env.local).
# Empty = picture uploads disabled.
BLOB_READ_WRITE_TOKEN=
# Optional: public base URL of picture files (default: the store's own URL)
PICTURES_BASE_URL=
# Vercel deploy hook URL of the website (production only, a secret). Empty = no site rebuilds.
SITE_DEPLOY_HOOK_URL=
